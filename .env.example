# GitHub Personal Access Token (Rate limits bypass karne ke liye)
GITHUB_TOKEN=your_github_personal_access_token_here

# Google Gemini API Key (Phase 3 AI features ke liye)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration (Local / Docker / Upstash / AWS ElastiCache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# App Environment
ENVIRONMENT=development
PORT=8000